{
  "schema_version": 1,
  "color": {
    "canvas": "#f3f6fa",
    "surface": "#ffffff",
    "text": "#172b42",
    "text_muted": "#52677e",
    "primary": "#185da8",
    "primary_text": "#ffffff",
    "border": "#c7d3df",
    "focus": "#087e8b",
    "danger": "#b42332",
    "success": "#21734b"
  },
  "typography": {
    "font_family": "Inter, PingFang SC, Microsoft YaHei, sans-serif",
    "base_px": 16,
    "line_height": 1.6,
    "scale_px": [
      12,
      14,
      16,
      20,
      28,
      36
    ]
  },
  "spacing_px": [
    4,
    8,
    12,
    16,
    24,
    32,
    48
  ],
  "radii_px": {
    "control": 8,
    "card": 12
  },
  "breakpoints_px": {
    "mobile": 390,
    "tablet": 768,
    "desktop": 1440
  },
  "contrast_pairs": [
    {
      "foreground": "text",
      "background": "surface",
      "usage": "text"
    },
    {
      "foreground": "text_muted",
      "background": "surface",
      "usage": "text"
    },
    {
      "foreground": "primary_text",
      "background": "primary",
      "usage": "text"
    },
    {
      "foreground": "focus",
      "background": "canvas",
      "usage": "non_text"
    }
  ],
  "motion": {
    "reduce_motion": true,
    "max_duration_ms": 180
  }
}
