{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "component_id": {
      "type": "string",
      "minLength": 1
    },
    "proposal_id": {
      "type": "string",
      "minLength": 1
    },
    "before": {
      "type": "string",
      "minLength": 1
    },
    "after": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "enum": [
        "not_executed",
        "committed",
        "unknown"
      ]
    }
  },
  "required": [
    "component_id",
    "proposal_id",
    "before",
    "after",
    "outcome"
  ],
  "additionalProperties": false
}
