{
  "schema_version": 1,
  "color": {
    "canvas": "#F4F7F6",
    "surface": "#FFFFFF",
    "text": "#1C3036",
    "text_muted": "#52676D",
    "primary": "#176C61",
    "primary_text": "#FFFFFF",
    "border": "#7C8B91",
    "focus": "#7C3DA0",
    "danger": "#AE3541",
    "success": "#246B44"
  },
  "typography": {
    "font_family": "PingFang SC, Microsoft YaHei, system-ui, sans-serif",
    "base_px": 16,
    "line_height": 1.5,
    "scale_px": [
      12,
      14,
      16,
      20,
      28,
      32
    ]
  },
  "spacing_px": [
    4,
    8,
    12,
    16,
    24,
    32,
    48,
    64
  ],
  "radii_px": {
    "control": 8,
    "card": 12
  },
  "breakpoints_px": {
    "mobile": 390,
    "tablet": 768,
    "desktop": 1280
  },
  "contrast_pairs": [
    {
      "foreground": "text",
      "background": "surface",
      "usage": "text"
    },
    {
      "foreground": "text_muted",
      "background": "surface",
      "usage": "text"
    },
    {
      "foreground": "primary_text",
      "background": "primary",
      "usage": "text"
    },
    {
      "foreground": "focus",
      "background": "canvas",
      "usage": "non_text"
    },
    {
      "foreground": "focus",
      "background": "surface",
      "usage": "non_text"
    },
    {
      "foreground": "danger",
      "background": "surface",
      "usage": "text"
    },
    {
      "foreground": "success",
      "background": "surface",
      "usage": "text"
    },
    {
      "foreground": "border",
      "background": "surface",
      "usage": "non_text"
    },
    {
      "foreground": "text",
      "background": "canvas",
      "usage": "text"
    }
  ],
  "motion": {
    "reduce_motion": true,
    "max_duration_ms": 140
  }
}
