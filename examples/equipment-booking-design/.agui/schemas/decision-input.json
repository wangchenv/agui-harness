{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "meeting-equipment-decision-input",
  "type": "object",
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 1
    },
    "decision": {
      "enum": [
        "offer_alternative",
        "reject"
      ]
    },
    "alternative_evidence_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "alternative": {
      "type": "object",
      "properties": {
        "equipment_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "start_at": {
          "type": "string",
          "format": "date-time"
        },
        "end_at": {
          "type": "string",
          "format": "date-time"
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "equipment_id",
        "start_at",
        "end_at",
        "timezone"
      ],
      "additionalProperties": false
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  },
  "required": [
    "case_id",
    "expected_revision",
    "decision",
    "reason"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "offer_alternative"
          }
        }
      },
      "then": {
        "required": [
          "alternative_evidence_id",
          "alternative"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "alternative_evidence_id"
              ]
            },
            {
              "required": [
                "alternative"
              ]
            }
          ]
        }
      }
    }
  ]
}
