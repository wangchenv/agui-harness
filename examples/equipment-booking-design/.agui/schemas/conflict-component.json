{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "meeting-equipment-conflict-component",
  "type": "object",
  "properties": {
    "component": {
      "const": "conflict_review"
    },
    "presentation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "case": {
      "type": "object",
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "site_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "requester_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "original_operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "requested_slot": {
          "type": "object",
          "properties": {
            "equipment_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "start_at": {
              "type": "string",
              "format": "date-time"
            },
            "end_at": {
              "type": "string",
              "format": "date-time"
            },
            "timezone": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "required": [
            "equipment_id",
            "start_at",
            "end_at",
            "timezone"
          ],
          "additionalProperties": false
        },
        "status": {
          "enum": [
            "open",
            "offered",
            "rejected"
          ]
        }
      },
      "required": [
        "case_id",
        "revision",
        "site_id",
        "requester_id",
        "original_operation_id",
        "requested_slot",
        "status"
      ],
      "additionalProperties": false
    },
    "decision_proposal": {
      "type": "object",
      "properties": {
        "decision_proposal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "case_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "case_revision": {
          "type": "integer",
          "minimum": 1
        },
        "decision": {
          "enum": [
            "offer_alternative",
            "reject"
          ]
        },
        "alternative": {
          "type": "object",
          "properties": {
            "equipment_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "start_at": {
              "type": "string",
              "format": "date-time"
            },
            "end_at": {
              "type": "string",
              "format": "date-time"
            },
            "timezone": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "required": [
            "equipment_id",
            "start_at",
            "end_at",
            "timezone"
          ],
          "additionalProperties": false
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "payload_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "decision_proposal_id",
        "case_id",
        "case_revision",
        "decision",
        "reason",
        "expires_at",
        "payload_hash"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": {
                "const": "offer_alternative"
              }
            }
          },
          "then": {
            "required": [
              "alternative"
            ]
          },
          "else": {
            "not": {
              "required": [
                "alternative"
              ]
            }
          }
        }
      ]
    },
    "operation": {
      "type": "object",
      "properties": {
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "approved",
            "executing",
            "committed",
            "failed",
            "unknown",
            "expired"
          ]
        },
        "receipt": {
          "type": "object",
          "properties": {
            "kind": {
              "const": "conflict_decision"
            },
            "operation_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "case_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "decision": {
              "enum": [
                "offer_alternative",
                "reject"
              ]
            },
            "case_revision": {
              "type": "integer",
              "minimum": 1
            },
            "decided_at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "kind",
            "operation_id",
            "case_id",
            "decision",
            "case_revision",
            "decided_at"
          ],
          "additionalProperties": false
        },
        "reason_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      },
      "required": [
        "operation_id",
        "revision",
        "status"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "committed"
              }
            }
          },
          "then": {
            "required": [
              "receipt"
            ],
            "not": {
              "required": [
                "reason_code"
              ]
            }
          },
          "else": {
            "not": {
              "required": [
                "receipt"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "failed",
                  "expired"
                ]
              }
            }
          },
          "then": {
            "required": [
              "reason_code"
            ]
          }
        }
      ]
    },
    "explanation": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "component",
    "presentation_id",
    "revision",
    "case",
    "explanation"
  ],
  "additionalProperties": false
}
