{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "meeting-equipment-decision-output",
  "type": "object",
  "properties": {
    "decision_proposal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "case_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "case_revision": {
      "type": "integer",
      "minimum": 1
    },
    "decision": {
      "enum": [
        "offer_alternative",
        "reject"
      ]
    },
    "alternative": {
      "type": "object",
      "properties": {
        "equipment_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "start_at": {
          "type": "string",
          "format": "date-time"
        },
        "end_at": {
          "type": "string",
          "format": "date-time"
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "equipment_id",
        "start_at",
        "end_at",
        "timezone"
      ],
      "additionalProperties": false
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "decision_proposal_id",
    "case_id",
    "case_revision",
    "decision",
    "reason",
    "expires_at",
    "payload_hash"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "offer_alternative"
          }
        }
      },
      "then": {
        "required": [
          "alternative"
        ]
      },
      "else": {
        "not": {
          "required": [
            "alternative"
          ]
        }
      }
    }
  ]
}
