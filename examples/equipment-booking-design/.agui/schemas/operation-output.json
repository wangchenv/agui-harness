{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "meeting-equipment-operation-output",
  "type": "object",
  "properties": {
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "approved",
        "executing",
        "committed",
        "failed",
        "unknown",
        "expired"
      ]
    },
    "receipt": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "booking"
            },
            "operation_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "reservation_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "equipment_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "owner_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "tenant_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "start_at": {
              "type": "string",
              "format": "date-time"
            },
            "end_at": {
              "type": "string",
              "format": "date-time"
            },
            "timezone": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "committed_at": {
              "type": "string",
              "format": "date-time"
            },
            "authority_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": [
            "kind",
            "operation_id",
            "reservation_id",
            "equipment_id",
            "owner_id",
            "tenant_ref",
            "start_at",
            "end_at",
            "timezone",
            "committed_at",
            "authority_ref"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "conflict_decision"
            },
            "operation_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "case_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "decision": {
              "enum": [
                "offer_alternative",
                "reject"
              ]
            },
            "case_revision": {
              "type": "integer",
              "minimum": 1
            },
            "decided_at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "kind",
            "operation_id",
            "case_id",
            "decision",
            "case_revision",
            "decided_at"
          ],
          "additionalProperties": false
        }
      ]
    },
    "reason_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    }
  },
  "required": [
    "operation_id",
    "revision",
    "status"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "committed"
          }
        }
      },
      "then": {
        "required": [
          "receipt"
        ],
        "not": {
          "required": [
            "reason_code"
          ]
        }
      },
      "else": {
        "not": {
          "required": [
            "receipt"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "failed",
              "expired"
            ]
          }
        }
      },
      "then": {
        "required": [
          "reason_code"
        ]
      }
    }
  ]
}
